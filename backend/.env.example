# SITEGUARD AI - Backend Environment Configuration

APP_NAME="SITEGUARD AI Backend"
APP_ENV="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# SQLite Database Location (defaults to siteguard.db in the backend folder)
DATABASE_URL="sqlite:///./siteguard.db"

# Allowed CORS Origins (comma-separated list for local frontend dev server)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Optional: Vision AI Provider Secret (stored safely server-side, never in React or Git)
GEMINI_API_KEY=""

# Authentication & JWT Configuration
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Evaluator Account (seeded automatically on startup)
DEMO_USER_EMAIL="demo@siteguard.ai"
DEMO_USER_PASSWORD="SiteGuard2026!"
DEMO_USER_NAME="A. Morgan"
DEMO_USER_ROLE="Director of Safety Operations"
